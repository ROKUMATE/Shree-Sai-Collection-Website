# Environment variables for a Vercel deployment.
# Add these in: Vercel dashboard → Project → Settings → Environment Variables
# (tick Production, Preview and Development unless noted otherwise).
#
# This file is the Vercel counterpart of .env.production.example, which covers
# the Docker/VPS deploy. The two differ because on Vercel the database is
# managed (Neon) and the filesystem is read-only.

# ---------- Database (required) ----------
# Neon gives you two URLs. The app runs on the POOLED one (-pooler in the host);
# `prisma migrate` needs the DIRECT one, because migrations take advisory locks
# that a transaction-mode pooler drops.
# NOTE: drop `channel_binding=require` from Neon's copy-paste string — Prisma's
# engine does not accept it. Keep `sslmode=require`.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---------- Session signing (required) ----------
# Generate with: openssl rand -hex 32
# Without this the app silently falls back to "dev-secret" and any session
# cookie could be forged.
JWT_SECRET=CHANGE_ME_64_hex_chars

# ---------- Public URL (required) ----------
# Used in order/reset emails, sitemap.xml and robots.txt. No trailing slash.
APP_URL=https://your-project.vercel.app

# ---------- First admin account ----------
# `npm run vercel-build` creates this admin on deploy if no admin exists yet.
# Safe to remove once the account exists.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---------- Product photo uploads ----------
# Vercel's filesystem is read-only, so admin-uploaded photos go to Vercel Blob.
# Create a store: Vercel dashboard → Storage → Create → Blob → connect to this
# project. BLOB_READ_WRITE_TOKEN is then injected automatically — you normally
# do NOT paste it by hand. Without it, photo upload fails on Vercel.
# BLOB_READ_WRITE_TOKEN=(auto-injected when a Blob store is connected)

# ---------- Razorpay (optional — omit for Cash on Delivery only) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → add https://YOUR_DOMAIN/api/webhooks/razorpay
# with events payment.captured + payment.failed
RAZORPAY_WEBHOOK_SECRET=

# ---------- SMTP (optional — omit to run without email) ----------
# Order confirmations and password-reset links. Without these, mail is a no-op
# and password reset cannot be completed by a customer.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shringar <orders@example.com>"
