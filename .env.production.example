# Copy to `.env` on the production server and fill in every value.

# Your domain, e.g. shringar.in (point its DNS A record at the server first)
DOMAIN=example.com

# Database credentials (docker-compose creates the DB with these)
POSTGRES_USER=shringar
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=shringar

# Session signing secret — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_hex_chars

# First admin account (created automatically on first start if no admin exists)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# Public URL of the store — used in emails (set after you have your domain)
APP_URL=https://example.com

# Razorpay LIVE keys (Dashboard → Settings → API Keys)
# Leave empty to launch with Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret (Dashboard → Settings → Webhooks → add
# https://YOUR_DOMAIN/api/webhooks/razorpay with events payment.captured + payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# SMTP for order/reset emails — leave empty to run without email.
# Works with any provider: Brevo, Zoho Mail, Amazon SES, Gmail app passwords, …
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shringar <orders@example.com>"
